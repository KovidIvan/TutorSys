# Set SECRET_KEY to a unique random value before deployment.
SECRET_KEY=replace-with-a-random-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Leave DB_ENGINE and DB_NAME empty to use local SQLite.
# For PostgreSQL, set DB_ENGINE=django.db.backends.postgresql and provide DB_NAME.
DB_ENGINE=
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_OUTBOX_POLL_SECONDS=5
SITE_URL=
USE_HTTPS=False
TELEGRAM_PRIVACY_MODE=full
TELEGRAM_REQUIRE_CONSENT=True
TELEGRAM_OUTBOX_KEEP_DAYS=7
